{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mint Launcher",
  "version": "0.1.8",
  "identifier": "com.mintlauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mint Launcher",
        "width": 900,
        "height": 580,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxNkFGOUMyNDZFQTJGQjQKUldTMEwrcEd3dmxxTVc0OFhzT0o5eHZqbjdTcFJYNmxtVWVVV2xUSC9XREppbkpqaUlnZGluZSsK",
      "endpoints": [
        "https://github.com/m3l0ncru2t/Mint-Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
